{
  "name": "aogd-records",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:local:apply": "node scripts/cloudflare-local.mjs migrate",
    "dev:cloudflare": "vite build && node scripts/cloudflare-local.mjs dev",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "corepack pnpm audit --audit-level high",
    "audit:prod": "corepack pnpm audit --prod --audit-level high",
    "test:security": "node scripts/security-smoke.mjs",
    "test:runtime": "node scripts/local-runtime-smoke.mjs",
    "check": "node scripts/security-smoke.mjs && vite build && node scripts/local-runtime-smoke.mjs && corepack pnpm audit --audit-level high"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@vitejs/plugin-react": "6.1.1",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
